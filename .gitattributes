# Mark Swift code as vendored so GitHub shows Rust as primary language
*.swift linguist-vendored
Sources/** linguist-vendored
Tests/** linguist-vendored
Package.swift linguist-vendored

# Pi-family session fixtures are byte-exact copies of upstream wire shapes;
# never EOL-convert them (parsers split on LF).
rust/src/agent_sessions/fixtures/** -text

# The shared Rust/TypeScript golden contract compares serialized JSON bytes.
docs/golden_surface_layouts.json text eol=lf
